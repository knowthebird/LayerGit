{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LayerGit Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/.vscode/debug-target.code-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "npm: watch"
    }
  ]
}
