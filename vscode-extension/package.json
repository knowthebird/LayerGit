{
  "name": "layergit-vscode",
  "displayName": "LayerGit",
  "description": "Thin VS Code UI over the LayerGit CLI.",
  "version": "0.0.1",
  "publisher": "layergit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowthebird/LayerGit.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:layergit.layers",
    "onView:layergit.composedTree",
    "onCommand:layergit.refresh",
    "onCommand:layergit.init",
    "onCommand:layergit.addLayer",
    "onCommand:layergit.addLocalLayer",
    "onCommand:layergit.compose",
    "onCommand:layergit.openOutput",
    "onCommand:layergit.applyAll",
    "onCommand:layergit.newFile",
    "onCommand:layergit.adoptFile",
    "onCommand:layergit.deleteFile",
    "onCommand:layergit.setWriteLayer",
    "onCommand:layergit.clearSelection",
    "onCommand:layergit.explainCurrentFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "LayerGit",
      "properties": {
        "layergit.command": {
          "type": "string",
          "default": "layer",
          "description": "LayerGit CLI command. Use \"python3 -m layergit.cli\" for local development if layer is not installed."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "layergit",
          "title": "LayerGit",
          "icon": "media/layergit-icon.svg"
        }
      ]
    },
    "views": {
      "layergit": [
        {
          "id": "layergit.layers",
          "name": "Layers"
        },
        {
          "id": "layergit.composedTree",
          "name": "Composed Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "layergit.refresh",
        "title": "LayerGit: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "layergit.init",
        "title": "LayerGit: Initialize Workspace"
      },
      {
        "command": "layergit.openOutput",
        "title": "LayerGit: Open Output",
        "icon": "$(output)"
      },
      {
        "command": "layergit.compose",
        "title": "LayerGit: Compose / Refresh Tree",
        "icon": "$(sync)"
      },
      {
        "command": "layergit.pullAll",
        "title": "LayerGit: Pull All Layers"
      },
      {
        "command": "layergit.addLayer",
        "title": "LayerGit: Add Layer...",
        "icon": "$(add)"
      },
      {
        "command": "layergit.addLocalLayer",
        "title": "LayerGit: Add Local Layer",
        "icon": "$(new-folder)"
      },
      {
        "command": "layergit.removeLayer",
        "title": "LayerGit: Remove Layer",
        "icon": "$(remove)"
      },
      {
        "command": "layergit.setWriteLayer",
        "title": "LayerGit: Set Write Layer",
        "icon": "$(edit)"
      },
      {
        "command": "layergit.openLayerCache",
        "title": "LayerGit: Open Layer Cache Repo"
      },
      {
        "command": "layergit.gitStatusLayer",
        "title": "LayerGit: Git Status for Layer"
      },
      {
        "command": "layergit.applyLayer",
        "title": "LayerGit: Apply Changes for Layer"
      },
      {
        "command": "layergit.applyAll",
        "title": "LayerGit: Apply All Changes",
        "icon": "$(check)"
      },
      {
        "command": "layergit.newFile",
        "title": "LayerGit: New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "layergit.explainCurrentFile",
        "title": "LayerGit: Explain Current File"
      },
      {
        "command": "layergit.explainFile",
        "title": "LayerGit: Explain File"
      },
      {
        "command": "layergit.enableLayer",
        "title": "LayerGit: Enable Layer"
      },
      {
        "command": "layergit.disableLayer",
        "title": "LayerGit: Disable Layer"
      },
      {
        "command": "layergit.moveLayerUp",
        "title": "LayerGit: Move Layer Up"
      },
      {
        "command": "layergit.moveLayerDown",
        "title": "LayerGit: Move Layer Down"
      },
      {
        "command": "layergit.sendLayerToTop",
        "title": "LayerGit: Send Layer to Top"
      },
      {
        "command": "layergit.sendLayerToBottom",
        "title": "LayerGit: Send Layer to Bottom"
      },
      {
        "command": "layergit.useLayerForFile",
        "title": "LayerGit: Use Layer for File"
      },
      {
        "command": "layergit.useLayerForFolder",
        "title": "LayerGit: Use Layer for Folder Recursively"
      },
      {
        "command": "layergit.applyFile",
        "title": "LayerGit: Apply to Owning Layer"
      },
      {
        "command": "layergit.adoptFile",
        "title": "LayerGit: Apply to Another Layer..."
      },
      {
        "command": "layergit.deleteFile",
        "title": "LayerGit: Delete from Owning Layer..."
      },
      {
        "command": "layergit.clearSelection",
        "title": "LayerGit: Clear Selection"
      },
      {
        "command": "layergit.openManifest",
        "title": "LayerGit: Open Manifest"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "layergit.refresh",
          "when": "(view == layergit.layers || view == layergit.composedTree) && layergit.workspaceFound",
          "group": "navigation"
        },
        {
          "command": "layergit.init",
          "when": "view == layergit.layers && !layergit.workspaceFound",
          "group": "navigation"
        },
        {
          "command": "layergit.addLayer",
          "when": "view == layergit.layers && layergit.workspaceFound",
          "group": "navigation"
        },
        {
          "command": "layergit.compose",
          "when": "view == layergit.composedTree && layergit.workspaceFound",
          "group": "navigation"
        },
        {
          "command": "layergit.applyAll",
          "when": "(view == layergit.layers || view == layergit.composedTree) && layergit.workspaceFound",
          "group": "navigation"
        },
        {
          "command": "layergit.newFile",
          "when": "view == layergit.composedTree && layergit.workspaceFound",
          "group": "navigation"
        },
        {
          "command": "layergit.openOutput",
          "when": "(view == layergit.layers || view == layergit.composedTree) && layergit.workspaceFound",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "layergit.enableLayer",
          "when": "view == layergit.layers && viewItem == layergit.layer.disabled",
          "group": "inline"
        },
        {
          "command": "layergit.disableLayer",
          "when": "view == layergit.layers && viewItem == layergit.layer.enabled",
          "group": "inline"
        },
        {
          "command": "layergit.removeLayer",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "inline"
        },
        {
          "command": "layergit.setWriteLayer",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "write"
        },
        {
          "command": "layergit.applyLayer",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "apply"
        },
        {
          "command": "layergit.moveLayerUp",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "movement"
        },
        {
          "command": "layergit.moveLayerDown",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "movement"
        },
        {
          "command": "layergit.sendLayerToTop",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "movement"
        },
        {
          "command": "layergit.sendLayerToBottom",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "movement"
        },
        {
          "command": "layergit.openLayerCache",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "repo"
        },
        {
          "command": "layergit.gitStatusLayer",
          "when": "view == layergit.layers && viewItem =~ /layergit\\.layer\\./",
          "group": "repo"
        },
        {
          "command": "layergit.init",
          "when": "view == layergit.layers && viewItem == layergit.action.initialize",
          "group": "inline"
        },
        {
          "command": "layergit.explainFile",
          "when": "view == layergit.composedTree && viewItem == layergit.file",
          "group": "inline"
        },
        {
          "command": "layergit.useLayerForFile",
          "when": "view == layergit.composedTree && viewItem == layergit.file",
          "group": "precedence"
        },
        {
          "command": "layergit.applyFile",
          "when": "view == layergit.composedTree && viewItem == layergit.file",
          "group": "apply"
        },
        {
          "command": "layergit.adoptFile",
          "when": "view == layergit.composedTree && viewItem == layergit.file",
          "group": "apply"
        },
        {
          "command": "layergit.deleteFile",
          "when": "view == layergit.composedTree && viewItem == layergit.file",
          "group": "delete"
        },
        {
          "command": "layergit.clearSelection",
          "when": "view == layergit.composedTree && viewItem == layergit.file",
          "group": "precedence"
        },
        {
          "command": "layergit.useLayerForFolder",
          "when": "view == layergit.composedTree && viewItem == layergit.directory",
          "group": "precedence"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-yarn --out layergit-vscode-0.0.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.5.4"
  }
}
